# Base URL of registry-service (farms and plots).
REGISTRY_URL=http://127.0.0.1:8000
# Base URL of weather-service (only its /health is called, for the status line).
WEATHER_URL=http://127.0.0.1:8001
# Base URL of planner-service (the irrigation plan).
PLANNER_URL=http://127.0.0.1:8002
# How long to wait for any service, in milliseconds. A whole number above 0. It must be longer
# than the planner's waits for its upstreams (registry 5 s + weather 45 s, see the planner's
# .env.example); scripts/tests/test_timeouts.py checks this.
REQUEST_TIMEOUT_MS=60000
